{
    "singleQuote": true,
    "semi": false,
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "trailingComma": "es5",
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "bracketSpacing": true,
    "overrides": [
        {
            "files": "*.html",
            "options": {
                "parser": "html"
            }
        },
        {
            "files": "*.component.html",
            "options": {
                "parser": "angular"
            }
        }
    ]
}