# Local Postgres connection string used by knex (development)
PSQL_DATABASE_URL=postgres://<user>:<password>@localhost:5432/cryptonite

# Production connection string (knex production environment)
DATABASE_URL=

# Individual Postgres settings
DATABASE_HOST=localhost
DATABASE_NAME=cryptonite
DATABASE_USER=postgres
DATABASE_PASSWORD=

# JWT secrets - use long random strings
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Supabase (used for file / avatar storage)
SUPABASE_HOST=
SUPABASE_USER=
SUPABASE_DATABASE=
SUPABASE_PASSWORD=
SUPABASE_PROJECT_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Port the API listens on (defaults to 8080)
PORT=8080
